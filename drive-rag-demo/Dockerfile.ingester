# Separate, customer-owned Google Drive source ingester. Do not put the private
# ingestion signing key or the provider access token in the RAG container.
FROM python:3.13-slim

WORKDIR /app
COPY drive-rag-demo/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY packages /app/packages
COPY connectors /app/connectors
CMD ["python", "-m", "connectors.google_drive.snapshot_agent", "--help"]
