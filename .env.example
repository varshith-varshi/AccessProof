ACCESSPROOF_ENV=development
ACCESSPROOF_PRODUCT_NAME=AccessProof
ACCESSPROOF_COMPANY_NAME=AccessProof Labs
ACCESSPROOF_SUPPORT_URL=https://example.invalid/support
ACCESSPROOF_SUPPORT_EMAIL=support@example.invalid
DATABASE_URL=postgresql+psycopg://accessproof:accessproof@localhost:5432/accessproof
REDIS_URL=redis://localhost:6379/0
SESSION_HMAC_KEY=change-me-with-at-least-32-random-bytes

# Secret backend: local | aws-kms
ACCESSPROOF_SECRET_BACKEND=local
SECRET_ENCRYPTION_KEY=change-me-32-byte-base64-or-dev-derived
# ACCESSPROOF_AWS_KMS_KEY_ID=alias/accessproof-secrets
# AWS_REGION=ap-south-1

REPORT_SIGNING_KEY=change-me-report-signing-key
WEB_ORIGIN=http://localhost:3000
ACCESSPROOF_ALLOWED_HOSTS=localhost,127.0.0.1
ACCESSPROOF_PUBLIC_APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
# ACCESSPROOF_OIDC_REDIRECT_URI=https://app.example.com/api/v1/auth/oidc/callback

# Email: console for development; smtp for production
ACCESSPROOF_EMAIL_MODE=console
ACCESSPROOF_EMAIL_FROM=noreply@example.invalid
# ACCESSPROOF_SMTP_HOST=smtp.example.com
# ACCESSPROOF_SMTP_PORT=587
# ACCESSPROOF_SMTP_USERNAME=...
# ACCESSPROOF_SMTP_PASSWORD=...
ACCESSPROOF_SMTP_STARTTLS=1

ACCESSPROOF_MIN_RUNNER_VERSION=0.1.0
ACCESSPROOF_RUNNER_OFFLINE_SECONDS=90
ACCESSPROOF_RETENTION_SWEEP_SECONDS=3600
RUNNER_POLL_SECONDS=2

# Optional real Google Drive-backed RAG demo. Never commit real values.
DRIVE_OWNER_TOKEN=
DRIVE_ROOT_FOLDER_ID=
# Separate OAuth Web Application for managed employee login to the demo RAG.
# Add this exact callback to Google Cloud OAuth Authorized redirect URIs.
# localhost callback below works only when you open the demo from localhost.
ACCESSPROOF_DEMO_GOOGLE_CLIENT_ID=
ACCESSPROOF_DEMO_GOOGLE_CLIENT_SECRET=
ACCESSPROOF_DEMO_GOOGLE_HOSTED_DOMAIN=
ACCESSPROOF_DEMO_GOOGLE_REDIRECT_URI=http://localhost:8200/v1/auth/google/callback
ALICE_EMAIL=
ALICE_RAG_TOKEN=
BOB_EMAIL=
BOB_RAG_TOKEN=
ACL_CACHE_SECONDS=20
DRIVE_RAG_PORT=8200

# Optional synthetic-only BYOK LLM probe generation. Deterministic probes remain mandatory.
# ACCESSPROOF_PROBE_LLM_ENDPOINT=https://api.example.com/v1/chat/completions
# ACCESSPROOF_PROBE_LLM_API_KEY=...
# ACCESSPROOF_PROBE_LLM_MODEL=...
# ACCESSPROOF_PROBE_LLM_PROVIDER=openai-compatible
# Required only when configuring an AccessProof prototype RAG target. Keep this
# runner/demo-ai shared secret out of browser configuration and source control.
# ACCESSPROOF_TEST_ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional OTLP tracing (install/run with the observability extra; Docker images include it)
# ACCESSPROOF_OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com/v1/traces
# ACCESSPROOF_OTEL_SERVICE_NAME=accessproof-api

# Google Drive guided OAuth (API process): register the exact callback shown
# in docs/google-drive-oauth-and-watch.md with your Google Cloud OAuth client.
# ACCESSPROOF_GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
# ACCESSPROOF_GOOGLE_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET

# Microsoft 365 / SharePoint (operator-side only, ONE MULTITENANT APP).
# Register AccessProof once in the OPERATOR home tenant with Supported
# account types = Accounts in any organizational directory.
# Exact callback: https://api.accessproof.in/api/v1/current/sources/microsoft-admin-consent/callback
# See scripts/register_accessproof_multitenant_entra.py and
# docs/ACCESSPROOF_MULTITENANT_ENTRA_ONBOARDING.md.
# Set the client ID and secret in the API/worker runtime, NOT in the browser.
# Site/library/drive/root IDs are entered in Sources > Connect SharePoint.
# ACCESSPROOF_MICROSOFT_CLIENT_ID=
# ACCESSPROOF_MICROSOFT_CLIENT_SECRET=
# An optional READ-ONLY CLI preflight also uses these additional environment keys:
# ACCESSPROOF_MICROSOFT_TENANT_ID=
# ACCESSPROOF_SHAREPOINT_SITE_ID=
# ACCESSPROOF_SHAREPOINT_LIST_ID=
# ACCESSPROOF_SHAREPOINT_DRIVE_ID=
# ACCESSPROOF_SHAREPOINT_ROOT_ITEM_ID=
# See docs/ACCESSPROOF_MICROSOFT_TRIAL_LIVE_VALIDATION_2026-10-27.md.

# Google Drive push wake-up (worker process): HTTPS callback must route to API.
# Without this, periodic ACL/directory reconciliation remains active.
# ACCESSPROOF_GOOGLE_WATCH_CALLBACK_URL=https://api.example.com/api/v1/provider-events/google-drive
# ACCESSPROOF_GOOGLE_WATCH_CHECK_SECONDS=900

# Optional customer-side reference RAG Redis answer cache (not universal interception):
# Only alongside strict attested source ingestion and Guard Protect mode.
# ACCESSPROOF_DEMO_CACHE_URL=redis://127.0.0.1:6379/0
# ACCESSPROOF_DEMO_REQUIRE_ATTESTED_CONTENT=1
# ACCESSPROOF_DEMO_CACHE_KEY_ID=customer-private-redis-cache-v1
# ACCESSPROOF_DEMO_CACHE_PRIVATE_KEY_B64=SERVER_SIDE_PRIVATE_ED25519_32_BYTE_RAW_KEY_BASE64

# Cache-agnostic reference RAG connector. Choose exactly one of these and
# provision its customer-owned credentials and network isolation.
# ACCESSPROOF_DEMO_CACHE_BACKEND=redis
# ACCESSPROOF_DEMO_CACHE_URL=rediss://user:password@private-redis:6379/0
# ACCESSPROOF_DEMO_CACHE_BACKEND=memcached
# ACCESSPROOF_DEMO_CACHE_MEMCACHED_HOST=private-memcached
# ACCESSPROOF_DEMO_CACHE_MEMCACHED_PORT=11211
# ACCESSPROOF_DEMO_CACHE_BACKEND=postgresql
# ACCESSPROOF_DEMO_CACHE_SQLALCHEMY_URL=postgresql+psycopg://user:secret@private-pg/cache
# ACCESSPROOF_GATEWAY_CACHE_PUBLIC_KEYS_JSON={"customer-cache-key-id":"base64url-encoded-32-byte-ed25519-public-key"}

# Optional customer-side Gateway model protocol.
# Default openai-compatible works with self-hosted API-compatible models.
# Native Anthropic or Gemini endpoints use their own wire format and auth
# headers, but only after Guard Layer 1 and before Guard Layer 2.
# ACCESSPROOF_GATEWAY_MODEL_PROVIDER=openai-compatible
# ACCESSPROOF_GATEWAY_MODEL_URL=http://model:8000/v1/chat/completions
# ACCESSPROOF_GATEWAY_MODEL_NAME=customer-model-id
# Claude native:
# ACCESSPROOF_GATEWAY_MODEL_PROVIDER=anthropic
# ACCESSPROOF_GATEWAY_MODEL_URL=https://api.anthropic.com/v1/messages
# ACCESSPROOF_GATEWAY_MODEL_NAME=customer-selected-claude-model-id
# Gemini native (model path and MODEL_NAME must agree):
# ACCESSPROOF_GATEWAY_MODEL_PROVIDER=gemini
# ACCESSPROOF_GATEWAY_MODEL_URL=https://generativelanguage.googleapis.com/v1beta/models/customer-selected-model-id:generateContent
# ACCESSPROOF_GATEWAY_MODEL_NAME=customer-selected-model-id
# Model credential is supplied privately by the customer, NOT in the browser.
# ACCESSPROOF_GATEWAY_MODEL_BEARER_TOKEN=customer-managed-api-key

# Controlled real Microsoft Entra employee switcher for SharePoint RAG.
# NEVER paste employee passwords here; browser redirects to Microsoft sign-in.
# ACCESSPROOF_DEMO_SOURCE_PROVIDER=microsoft365
# ACCESSPROOF_DEMO_ENTRA_TENANT_ID=6479e7ca-b256-4ebc-a408-871b9046547c
# ACCESSPROOF_DEMO_ENTRA_CLIENT_ID=  # a SEPARATE Entra web-app registration, client ID only
# ACCESSPROOF_DEMO_ENTRA_CLIENT_SECRET=  # server-side Entra app secret, private
# ACCESSPROOF_DEMO_ENTRA_DOMAIN=neuralmatrix093.onmicrosoft.com
# ACCESSPROOF_DEMO_ENTRA_REDIRECT_URI=http://localhost:8200/v1/auth/entra/callback
# ACCESSPROOF_DEMO_ENTRA_ALICE_EMAIL=  # exact verified UPN; no assumptions
# ACCESSPROOF_DEMO_ENTRA_BOB_EMAIL=  # exact verified UPN; no assumptions
# For Guard: issuer https://login.microsoftonline.com/<tenant-guid>/v2.0
# ACCESSPROOF_GUARD_IDENTITY_SUBJECT_CLAIM=oid
