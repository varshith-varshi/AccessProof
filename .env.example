ACCESSPROOF_ENV=development
ACCESSPROOF_PRODUCT_NAME=AccessProof
ACCESSPROOF_COMPANY_NAME=AccessProof Labs
ACCESSPROOF_SUPPORT_URL=https://example.invalid/support
ACCESSPROOF_SUPPORT_EMAIL=support@example.invalid
DATABASE_URL=postgresql+psycopg://accessproof:accessproof@localhost:5432/accessproof
REDIS_URL=redis://localhost:6379/0
SESSION_HMAC_KEY=change-me-with-at-least-32-random-bytes

# Secret backend: local | aws-kms
ACCESSPROOF_SECRET_BACKEND=local
SECRET_ENCRYPTION_KEY=change-me-32-byte-base64-or-dev-derived
# ACCESSPROOF_AWS_KMS_KEY_ID=alias/accessproof-secrets
# AWS_REGION=ap-south-1

REPORT_SIGNING_KEY=change-me-report-signing-key
WEB_ORIGIN=http://localhost:3000
ACCESSPROOF_ALLOWED_HOSTS=localhost,127.0.0.1
ACCESSPROOF_PUBLIC_APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
# ACCESSPROOF_OIDC_REDIRECT_URI=https://app.example.com/api/v1/auth/oidc/callback

# Email: console for development; smtp for production
ACCESSPROOF_EMAIL_MODE=console
ACCESSPROOF_EMAIL_FROM=noreply@example.invalid
# ACCESSPROOF_SMTP_HOST=smtp.example.com
# ACCESSPROOF_SMTP_PORT=587
# ACCESSPROOF_SMTP_USERNAME=...
# ACCESSPROOF_SMTP_PASSWORD=...
ACCESSPROOF_SMTP_STARTTLS=1

ACCESSPROOF_MIN_RUNNER_VERSION=0.1.0
ACCESSPROOF_RUNNER_OFFLINE_SECONDS=90
ACCESSPROOF_RETENTION_SWEEP_SECONDS=3600
RUNNER_POLL_SECONDS=2

# Optional real Google Drive-backed RAG demo. Never commit real values.
DRIVE_OWNER_TOKEN=
DRIVE_ROOT_FOLDER_ID=
ALICE_EMAIL=
ALICE_RAG_TOKEN=
BOB_EMAIL=
BOB_RAG_TOKEN=
ACL_CACHE_SECONDS=20
DRIVE_RAG_PORT=8200

# Optional synthetic-only BYOK LLM probe generation. Deterministic probes remain mandatory.
# ACCESSPROOF_PROBE_LLM_ENDPOINT=https://api.example.com/v1/chat/completions
# ACCESSPROOF_PROBE_LLM_API_KEY=...
# ACCESSPROOF_PROBE_LLM_MODEL=...
# ACCESSPROOF_PROBE_LLM_PROVIDER=openai-compatible
# Required only when configuring an AccessProof prototype RAG target. Keep this
# runner/demo-ai shared secret out of browser configuration and source control.
# ACCESSPROOF_TEST_ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional OTLP tracing (install/run with the observability extra; Docker images include it)
# ACCESSPROOF_OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com/v1/traces
# ACCESSPROOF_OTEL_SERVICE_NAME=accessproof-api
