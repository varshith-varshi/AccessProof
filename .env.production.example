# Copy to .env.production and replace every value before deployment. Do not commit it.
ACCESSPROOF_API_IMAGE=registry.example.com/accessproof/api:RELEASE_TAG
ACCESSPROOF_WORKER_IMAGE=registry.example.com/accessproof/worker:RELEASE_TAG
ACCESSPROOF_WEB_IMAGE=registry.example.com/accessproof/web:RELEASE_TAG

DATABASE_URL=postgresql+psycopg://accessproof:REPLACE_WITH_PASSWORD@managed-postgres.example:5432/accessproof?sslmode=require
REDIS_URL=rediss://:REPLACE_WITH_PASSWORD@managed-redis.example:6380/0
WEB_ORIGIN=https://app.accessproof.in
CORS_ALLOWED_ORIGINS=https://app.accessproof.in
ACCESSPROOF_PUBLIC_APP_URL=https://app.accessproof.in
API_PUBLIC_URL=https://api.accessproof.in
# Public, non-secret frontend configuration. The Next.js server continues to
# proxy browser /api requests internally to http://api:8000.
NEXT_PUBLIC_API_URL=https://api.accessproof.in
ACCESSPROOF_ALLOWED_HOSTS=api.accessproof.in
# Exact private IP(s) of the Nginx/Caddy proxy that may send X-Forwarded-*
# headers. Do not use *. Example only; replace for the deployed proxy.
ACCESSPROOF_FORWARDED_ALLOW_IPS=172.20.0.10
SESSION_HMAC_KEY=REPLACE_WITH_A_UNIQUE_32_PLUS_CHARACTER_SECRET
SECRET_ENCRYPTION_KEY=REPLACE_WITH_A_UNIQUE_32_PLUS_CHARACTER_SECRET
REPORT_SIGNING_KEY=REPLACE_WITH_A_UNIQUE_32_PLUS_CHARACTER_SECRET
ACCESSPROOF_SECRET_BACKEND=local

ACCESSPROOF_EMAIL_MODE=smtp
ACCESSPROOF_EMAIL_FROM=noreply@example.com
ACCESSPROOF_SMTP_HOST=smtp.example.com
ACCESSPROOF_SMTP_PORT=587
ACCESSPROOF_SMTP_USERNAME=REPLACE_ME
ACCESSPROOF_SMTP_PASSWORD=REPLACE_ME
ACCESSPROOF_SMTP_STARTTLS=1

# Register this exact URL with Microsoft Entra or another OIDC provider when
# organization SSO is enabled. It intentionally uses the app domain so the
# host-only browser session and CSRF cookies are set on app.accessproof.in.
ACCESSPROOF_OIDC_REDIRECT_URI=https://app.accessproof.in/api/v1/auth/oidc/callback

# Private runners use the public API. Customer RAG URLs remain independently
# configured on each target and may stay private.
ACCESSPROOF_API_URL=https://api.accessproof.in

# Optional, strongly recommended: managed key encryption.
# ACCESSPROOF_SECRET_BACKEND=aws-kms
# ACCESSPROOF_AWS_KMS_KEY_ID=alias/accessproof-secrets
# AWS_REGION=ap-south-1
