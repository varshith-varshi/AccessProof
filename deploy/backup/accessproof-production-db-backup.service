# TEMPLATE ONLY. DO NOT ENABLE without owner-approved AWS role, KMS bucket, DB grant and restore plan.
[Unit]
Description=AccessProof encrypted PostgreSQL recovery archive (not a restore)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=accessproof-backup
Group=accessproof-backup
Environment=AWS_PROFILE=accessproof-backup-writer
Environment=AWS_CONFIG_FILE=/etc/accessproof-backup/aws-config
EnvironmentFile=/etc/accessproof-backup/config.env
ExecStart=/usr/bin/python3 /opt/accessproof-backup/production_s3_backup.py --bucket ${AP_BACKUP_BUCKET} --kms-key-arn ${AP_BACKUP_KMS_KEY_ARN} --db-host ${AP_BACKUP_DB_HOST} --db-port 5432 --database ${AP_BACKUP_DATABASE} --db-user ${AP_BACKUP_DB_USER} --pgpass-file /etc/accessproof-backup/pgpass
TimeoutStartSec=1800
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
UMask=0077
