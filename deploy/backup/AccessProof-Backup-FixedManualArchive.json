{
  "schemaVersion": "2.2",
  "description": "Fixed audited no-parameter AWS SSM PostgreSQL backup on exact production host; dedicated backup writer role; encrypted S3 with full SHA256 verification.",
  "parameters": {},
  "mainSteps": [
    {
      "action": "aws:runShellScript",
      "name": "pinnedBackup",
      "inputs": {
        "timeoutSeconds": "1800",
        "runCommand": [
          "set -eu",
          "umask 077",
          "cd /home/ubuntu/accessproof",
          "python3 - <<'AP_FIXED_BACKUP_END'",
          "import base64,fcntl,hashlib,io,json,os,subprocess,sys,time,urllib.request,uuid",
          "from datetime import datetime,timezone",
          "import boto3",
          "from boto3.s3.transfer import TransferConfig",
          "ACCOUNT=\"102076848988\"",
          "INSTANCE=\"i-0c11427d4d9c1b438\"",
          "BUCKET=\"accessproof-prod-db-backups-102076848988-eu-north-1\"",
          "KMS=\"arn:aws:kms:eu-north-1:102076848988:key/f4fa2b73-3a5e-4ae7-8919-9a013a5ba61e\"",
          "WRITER=\"arn:aws:iam::102076848988:role/AccessProofProductionBackupWriter\"",
          "EXPECTED=\"arn:aws:sts::102076848988:assumed-role/AccessProofEC2SSMManaged20261101/\"",
          "class Refused(Exception):pass",
          "def instance():",
          "    opener=urllib.request.build_opener(urllib.request.ProxyHandler({}))",
          "    req=urllib.request.Request(\"http://169.254.169.254/latest/api/token\",data=b\"\",method=\"PUT\",headers={\"X-aws-ec2-metadata-token-ttl-seconds\":\"60\"})",
          "    with opener.open(req,timeout=3) as f: token=f.read(200).decode(\"ascii\")",
          "    if not token:raise Refused(\"IMDS_TOKEN_REQUIRED\")",
          "    req=urllib.request.Request(\"http://169.254.169.254/latest/meta-data/instance-id\",headers={\"X-aws-ec2-metadata-token\":token})",
          "    with opener.open(req,timeout=3) as f:return f.read(100).decode(\"ascii\")",
          "def s3_client():",
          "    if os.geteuid()!=0 or instance()!=INSTANCE:raise Refused(\"PINNED_SSM_HOST_REQUIRED\")",
          "    base=boto3.session.Session(region_name=\"eu-north-1\")",
          "    sts=base.client(\"sts\")",
          "    identity=sts.get_caller_identity()",
          "    if identity.get(\"Account\")!=ACCOUNT or not identity.get(\"Arn\",\"\").startswith(EXPECTED):raise Refused(\"PINNED_EC2_ROLE_REQUIRED\")",
          "    c=sts.assume_role(RoleArn=WRITER,RoleSessionName=\"backup-\"+uuid.uuid4().hex[:12],DurationSeconds=3600)[\"Credentials\"]",
          "    session=boto3.session.Session(aws_access_key_id=c[\"AccessKeyId\"],aws_secret_access_key=c[\"SecretAccessKey\"],aws_session_token=c[\"SessionToken\"],region_name=\"eu-north-1\")",
          "    if not session.client(\"sts\").get_caller_identity().get(\"Arn\",\"\").startswith(\"arn:aws:sts::102076848988:assumed-role/AccessProofProductionBackupWriter/\"):raise Refused(\"BACKUP_ROLE_REQUIRED\")",
          "    return session.client(\"s3\")",
          "class Stream:",
          "    def __init__(self,fp):",
          "        self.fp=fp;self.hasher=hashlib.sha256();self.length=0;self.magic=b\"\";self.start=time.monotonic()",
          "    def read(self,size=-1):",
          "        if size<0:size=128*1024*1024+1",
          "        if size==0:return b''",
          "        if size>128*1024*1024+1:raise Refused('STREAM_MEMORY_CAP_EXCEEDED')",
          "        if time.monotonic()-self.start>900:raise Refused(\"DUMP_TIMEOUT\")",
          "        chunk=self.fp.read(size)",
          "        self.length+=len(chunk)",
          "        if self.length>1024*1024*1024:raise Refused(\"DUMP_SIZE_LIMIT\")",
          "        self.magic=(self.magic+chunk[:5])[:5]",
          "        self.hasher.update(chunk)",
          "        return chunk",
          "def verify(s3,key,length,checksum):",
          "    meta=s3.head_object(Bucket=BUCKET,Key=key,ChecksumMode=\"ENABLED\")",
          "    if meta.get(\"ContentLength\")!=length or meta.get(\"ServerSideEncryption\")!=\"aws:kms\" or meta.get(\"SSEKMSKeyId\")!=KMS:raise Refused(\"S3_ENCRYPTION_OR_SIZE_INVALID\")",
          "    stored=meta.get(\"ChecksumSHA256\")",
          "    if not isinstance(stored,str) or len(base64.b64decode(stored,validate=True))!=32:raise Refused(\"S3_CHECKSUM_MISSING\")",
          "    body=s3.get_object(Bucket=BUCKET,Key=key)[\"Body\"]",
          "    digest=hashlib.sha256();total=0",
          "    try:",
          "        while True:",
          "            part=body.read(1024*1024)",
          "            if not part:break",
          "            total+=len(part)",
          "            if total>length:raise Refused(\"S3_OBJECT_TOO_LARGE\")",
          "            digest.update(part)",
          "    finally:body.close()",
          "    if total!=length or digest.hexdigest()!=checksum:raise Refused(\"S3_FULL_SHA256_MISMATCH\")",
          "def main():",
          "    with open(\"/run/lock/accessproof-db-archive.lock\",\"a+b\") as lock:",
          "        fcntl.flock(lock.fileno(),fcntl.LOCK_EX|fcntl.LOCK_NB)",
          "        s3=s3_client()",
          "        prefix=\"database/\"+datetime.now(timezone.utc).strftime(\"%Y%m%dT%H%M%SZ\")+\"-\"+uuid.uuid4().hex",
          "        key=prefix+\".dump\"",
          "        pg=[\"docker\",\"compose\",\"-f\",\"/home/ubuntu/accessproof/docker-compose.ec2.yml\",\"exec\",\"-T\",\"db\",\"pg_dump\",\"-U\",\"accessproof\",\"-d\",\"accessproof\",\"--format=custom\",\"--no-owner\",\"--no-privileges\"]",
          "        proc=subprocess.Popen(pg,cwd=\"/home/ubuntu/accessproof\",stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL)",
          "        try:",
          "            if proc.stdout is None:raise Refused(\"NO_PG_DUMP_PIPE\")",
          "            stream=Stream(proc.stdout)",
          "            s3.upload_fileobj(stream,BUCKET,key,ExtraArgs={\"ServerSideEncryption\":\"aws:kms\",\"SSEKMSKeyId\":KMS,\"ChecksumAlgorithm\":\"SHA256\"},Config=TransferConfig(multipart_threshold=8*1024*1024,multipart_chunksize=8*1024*1024,use_threads=False))",
          "            proc.stdout.close()",
          "            if proc.wait(timeout=120)!=0 or stream.magic!=b\"PGDMP\" or stream.length<5:raise Refused(\"PG_DUMP_FAILED\")",
          "        finally:",
          "            if proc.stdout and not proc.stdout.closed:proc.stdout.close()",
          "            if proc.poll() is None:proc.kill();proc.wait(timeout=15)",
          "        sha=stream.hasher.hexdigest()",
          "        verify(s3,key,stream.length,sha)",
          "        manifest={\"schema\":\"accessproof.production_postgres_backup/v1\",\"created_at\":datetime.now(timezone.utc).isoformat(),\"instance_id\":INSTANCE,\"database\":\"accessproof\",\"bucket\":BUCKET,\"object_key\":key,\"archive_bytes\":stream.length,\"archive_sha256\":sha,\"s3_kms_key_arn\":KMS,\"restore_verified\":False}",
          "        data=json.dumps(manifest,sort_keys=True,separators=(\",\",\":\")).encode()",
          "        mkey=prefix+\".manifest.json\"",
          "        s3.put_object(Bucket=BUCKET,Key=mkey,Body=data,ServerSideEncryption=\"aws:kms\",SSEKMSKeyId=KMS,ChecksumAlgorithm=\"SHA256\")",
          "        verify(s3,mkey,len(data),hashlib.sha256(data).hexdigest())",
          "        print(json.dumps({\"status\":\"ENCRYPTED_ARCHIVE_COMMITTED_RESTORE_UNVERIFIED\",\"manifest\":mkey,\"bytes\":stream.length,\"restore_verified\":False}))",
          "try:main()",
          "except Exception as exc:",
          "    reason=str(exc) if isinstance(exc,Refused) else \"BACKUP_RUNTIME_FAILURE\"",
          "    print(json.dumps({\"status\":\"BACKUP_NOT_COMMITTED\",\"reason\":reason}),file=sys.stderr)",
          "    sys.exit(2)",
          "AP_FIXED_BACKUP_END"
        ]
      }
    }
  ]
}
