[Unit]
Description=AccessProof local certificate renewal prerequisite watchdog
After=network-online.target
OnFailure=accessproof-renewal-watchdog-alert.service

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/AccessProof-universal
ExecStart=%h/Projects/AccessProof-universal/.venv/bin/python -m scripts.certifier.renewal_watchdog
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0077
TimeoutStartSec=30s
