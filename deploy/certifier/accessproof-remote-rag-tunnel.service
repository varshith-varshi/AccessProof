# Cross-server validation tunnel to the staging Linux RAG host (SSH over AWS SSM;
# no inbound security-group rules, no public ports).
#   staging 127.0.0.1:18443 -> lab 127.0.0.1:8443 (remote-mode Gateway: TLS + signed requests only)
#   lab 127.0.0.1:28187/28188 -> staging 127.0.0.1:8187/8188 (LangChain / LlamaIndex RAG routes)
# Both ends bind LOOPBACK only (sshd GatewayPorts=no on the staging host). No Guard,
# model or database port is forwarded. The staging host key is pinned (known_hosts,
# StrictHostKeyChecking=yes). Every (re)connect pushes a 60-second EC2 Instance
# Connect key; nothing is persisted on the host.
#
# Requires: AWS CLI v2 + session-manager-plugin in ~/.local/bin and NON-INTERACTIVE
# AWS credentials (see deploy/certifier/README-24x7.md; a console `aws login`
# session expires and the tunnel would stop reconnecting).
#
# Install (owner; Claude may not open ingress tunnels):
#   cp deploy/certifier/accessproof-remote-rag-tunnel.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now accessproof-remote-rag-tunnel
[Unit]
Description=AccessProof cross-server RAG validation tunnel (SSH over SSM)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Environment=AWS_PROFILE=accessproof-staging-tunnel
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=%h/.local/bin/aws ec2-instance-connect send-ssh-public-key --region eu-north-1 --instance-id i-0e6d2256a1e5a6f67 --instance-os-user ubuntu --ssh-public-key file://%h/.ap-id/remote-gw/ssh_ed25519.pub
ExecStart=/usr/bin/ssh -F %h/.ap-id/remote-gw/ssh_config -N -o BatchMode=yes -o StrictHostKeyChecking=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o ControlMaster=no -R 127.0.0.1:18443:127.0.0.1:8443 -L 127.0.0.1:28187:127.0.0.1:8187 -L 127.0.0.1:28188:127.0.0.1:8188 ap-staging
Restart=always
RestartSec=20

[Install]
WantedBy=default.target
