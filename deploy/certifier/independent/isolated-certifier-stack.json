{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "AccessProof dedicated private EC2, NAT, restricted IAM and disabled-by-default KMS Ed25519 signer. Billable resources; requires separate administrator deployment.",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "LatestAmiId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
    },
    "InstanceType": {
      "Type": "String",
      "Default": "t3.small",
      "AllowedValues": [
        "t3.small",
        "t3.medium"
      ]
    },
    "PublicSubnetId": {
      "Type": "AWS::EC2::Subnet::Id",
      "Description": "Existing public subnet for the NAT gateway, with an active default route to an Internet Gateway"
    },
    "PrivateSubnetCidr": {
      "Type": "String",
      "Default": "172.31.48.0/24",
      "AllowedPattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:2[4-8])$",
      "Description": "Unused non-overlapping CIDR in selected VPC; default is unused in observed eu-north-1 VPC on 2026-11-07"
    },
    "CertifierAvailabilityZone": {
      "Type": "String",
      "Default": "eu-north-1c",
      "AllowedValues": [
        "eu-north-1a",
        "eu-north-1b",
        "eu-north-1c"
      ],
      "Description": "Same AZ as NAT public subnet to avoid unnecessary cross-AZ traffic"
    }
  },
  "Resources": {
    "CertifierSigningKey": {
      "Type": "AWS::KMS::Key",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "Independent AccessProof Ed25519 certifier; signing disabled until explicit trust approval",
        "KeyUsage": "SIGN_VERIFY",
        "KeySpec": "ECC_NIST_EDWARDS25519",
        "Enabled": true,
        "PendingWindowInDays": 30,
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AllowExplicitAccountKeyAdministratorsOnly",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:root"
                }
              },
              "Action": "kms:*",
              "Resource": "*"
            }
          ]
        },
        "Tags": [
          {
            "Key": "Product",
            "Value": "AccessProof"
          },
          {
            "Key": "Purpose",
            "Value": "IndependentCertifier"
          }
        ]
      }
    },
    "CertifierKeyAlias": {
      "Type": "AWS::KMS::Alias",
      "Properties": {
        "AliasName": {
          "Fn::Sub": "alias/accessproof-independent-certifier-${AWS::StackName}"
        },
        "TargetKeyId": {
          "Ref": "CertifierSigningKey"
        }
      }
    },
    "CertifierSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Independent certifier, no ingress, HTTPS outbound only",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0",
            "Description": "HTTPS to required AWS and authorized identity services, restrict at NAT/proxy"
          }
        ],
        "Tags": [
          {
            "Key": "Product",
            "Value": "AccessProof"
          },
          {
            "Key": "Purpose",
            "Value": "IndependentCertifier"
          }
        ]
      }
    },
    "CertifierBaseRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"
          }
        ],
        "MaxSessionDuration": 3600,
        "Tags": [
          {
            "Key": "Product",
            "Value": "AccessProof"
          }
        ],
        "RoleName": "AccessProofIndependentCertifierBase2026"
      }
    },
    "CertifierExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::GetAtt": [
                    "CertifierBaseRole",
                    "Arn"
                  ]
                }
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "MaxSessionDuration": 3600,
        "Policies": [
          {
            "PolicyName": "PublicKeyReadOnlyBeforeReviewedCutover",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "kms:GetPublicKey",
                    "kms:DescribeKey"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "CertifierSigningKey",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          },
          {
            "PolicyName": "ProductionCertifiedStateReadOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "OnlyFixedReadOnlyDocumentOnPinnedProductionInstance",
                  "Effect": "Allow",
                  "Action": "ssm:SendCommand",
                  "Resource": [
                    "arn:aws:ssm:eu-north-1:102076848988:document/AccessProof-Certifier-ProductionReadOnly",
                    "arn:aws:ec2:eu-north-1:102076848988:instance/i-0c11427d4d9c1b438"
                  ]
                },
                {
                  "Sid": "ReadOnlyResultOfOwnStatusInvocation",
                  "Effect": "Allow",
                  "Action": "ssm:GetCommandInvocation",
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": "eu-north-1"
                    }
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Product",
            "Value": "AccessProof"
          }
        ],
        "RoleName": "AccessProofIndependentCertifierExec2026"
      }
    },
    "AllowBaseRoleToAssumeExecution": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "AssumeOnlyIndependentCertifierRole",
        "Roles": [
          {
            "Ref": "CertifierBaseRole"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "sts:AssumeRole",
              "Resource": {
                "Fn::GetAtt": [
                  "CertifierExecutionRole",
                  "Arn"
                ]
              }
            }
          ]
        }
      }
    },
    "CertifierInstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "CertifierBaseRole"
          }
        ],
        "InstanceProfileName": "AccessProofIndependentCertifier2026"
      }
    },
    "CertifierInstance": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "LatestAmiId"
        },
        "InstanceType": {
          "Ref": "InstanceType"
        },
        "IamInstanceProfile": {
          "Ref": "CertifierInstanceProfile"
        },
        "Monitoring": true,
        "MetadataOptions": {
          "HttpEndpoint": "enabled",
          "HttpTokens": "required",
          "HttpPutResponseHopLimit": 1
        },
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "SubnetId": {
              "Ref": "CertifierPrivateSubnet"
            },
            "GroupSet": [
              {
                "Ref": "CertifierSecurityGroup"
              }
            ],
            "AssociatePublicIpAddress": false,
            "DeleteOnTermination": true
          }
        ],
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeType": "gp3",
              "VolumeSize": 30,
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "UserData": {
          "Fn::Base64": "#!/bin/bash\nset -euo pipefail\ninstall -d -o root -g root -m 0755 /opt/accessproof-independent-certifier\ninstall -d -o root -g root -m 0700 /etc/accessproof-independent-certifier\nprintf '%s\\n' 'CERTIFIER_INACTIVE_BY_DEFAULT: no signer service or employee session installed' > /opt/accessproof-independent-certifier/STATUS\nchmod 0644 /opt/accessproof-independent-certifier/STATUS\n"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "AccessProof-IndependentCertifier"
          },
          {
            "Key": "Product",
            "Value": "AccessProof"
          },
          {
            "Key": "Authorization",
            "Value": "ObserverOnlyUntilTrustAndEmployeeConsent"
          }
        ]
      },
      "DependsOn": [
        "CertifierPrivateDefaultRoute",
        "CertifierPrivateRouteAssociation"
      ]
    },
    "CertifierPrivateSubnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "CidrBlock": {
          "Ref": "PrivateSubnetCidr"
        },
        "AvailabilityZone": {
          "Ref": "CertifierAvailabilityZone"
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": "AccessProof-IndependentCertifier-Private"
          }
        ]
      }
    },
    "CertifierNatElasticIp": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc",
        "Tags": [
          {
            "Key": "Product",
            "Value": "AccessProof"
          },
          {
            "Key": "Purpose",
            "Value": "IndependentCertifier-Nat"
          }
        ]
      }
    },
    "CertifierNatGateway": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicSubnetId"
        },
        "AllocationId": {
          "Fn::GetAtt": [
            "CertifierNatElasticIp",
            "AllocationId"
          ]
        },
        "Tags": [
          {
            "Key": "Product",
            "Value": "AccessProof"
          },
          {
            "Key": "Purpose",
            "Value": "IndependentCertifier-Nat"
          }
        ]
      }
    },
    "CertifierPrivateRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "Tags": [
          {
            "Key": "Product",
            "Value": "AccessProof"
          },
          {
            "Key": "Purpose",
            "Value": "IndependentCertifier-PrivateRoute"
          }
        ]
      }
    },
    "CertifierPrivateDefaultRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "CertifierPrivateRouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Ref": "CertifierNatGateway"
        }
      }
    },
    "CertifierPrivateRouteAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "CertifierPrivateSubnet"
        },
        "RouteTableId": {
          "Ref": "CertifierPrivateRouteTable"
        }
      }
    }
  },
  "Outputs": {
    "CertifierInstanceId": {
      "Value": {
        "Ref": "CertifierInstance"
      }
    },
    "CertifierExecutionRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "CertifierExecutionRole",
          "Arn"
        ]
      }
    },
    "CertifierSigningKeyArn": {
      "Value": {
        "Fn::GetAtt": [
          "CertifierSigningKey",
          "Arn"
        ]
      }
    },
    "CertifierKeyId": {
      "Value": {
        "Ref": "CertifierSigningKey"
      }
    },
    "CertifierState": {
      "Value": "OBSERVER_ONLY_NOT_CERTIFIED_NO_SIGN_PERMISSIONS_NO_EMPLOYEE_SESSIONS"
    },
    "CertifierPrivateSubnetId": {
      "Value": {
        "Ref": "CertifierPrivateSubnet"
      }
    },
    "CertifierNatGatewayId": {
      "Value": {
        "Ref": "CertifierNatGateway"
      }
    }
  }
}
