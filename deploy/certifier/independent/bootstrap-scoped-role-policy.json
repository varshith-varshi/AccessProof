{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyNamedCertifierStack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateStack",
        "cloudformation:UpdateStack",
        "cloudformation:DeleteStack",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:GetTemplate",
        "cloudformation:ListStackResources",
        "cloudformation:CreateChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet"
      ],
      "Resource": [
        "arn:aws:cloudformation:eu-north-1:102076848988:stack/accessproof-independent-certifier-2026/*",
        "arn:aws:cloudformation:eu-north-1:102076848988:changeSet/awscli-cloudformation-package-deploy-*/*"
      ]
    },
    {
      "Sid": "ValidationAndStackList",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ValidateTemplate",
        "cloudformation:ListStacks"
      ],
      "Resource": "*"
    },
    {
      "Sid": "StockholmEc2ResourcesForStack",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:CreateSubnet",
        "ec2:DeleteSubnet",
        "ec2:CreateRouteTable",
        "ec2:DeleteRouteTable",
        "ec2:CreateRoute",
        "ec2:DeleteRoute",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:AllocateAddress",
        "ec2:ReleaseAddress",
        "ec2:CreateNatGateway",
        "ec2:DeleteNatGateway",
        "ec2:CreateSecurityGroup",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:RunInstances",
        "ec2:TerminateInstances",
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "OnlyDedicatedCertifierRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:DeleteRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::102076848988:role/AccessProofIndependentCertifierBase2026",
        "arn:aws:iam::102076848988:role/AccessProofIndependentCertifierExec2026"
      ]
    },
    {
      "Sid": "OnlyDedicatedCertifierInstanceProfiles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateInstanceProfile",
        "iam:GetInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:TagInstanceProfile"
      ],
      "Resource": "arn:aws:iam::102076848988:instance-profile/AccessProofIndependentCertifier2026"
    },
    {
      "Sid": "PassOnlyCertifierRolesToEc2",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::102076848988:role/AccessProofIndependentCertifierBase2026",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "OnlyKeyCreationWithProductTags",
      "Effect": "Allow",
      "Action": "kms:CreateKey",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Product": "AccessProof",
          "aws:RequestTag/Purpose": "IndependentCertifier",
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "ManageOnlyIsolatedCertifierKey",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:GetKeyPolicy",
        "kms:PutKeyPolicy",
        "kms:TagResource",
        "kms:UntagResource",
        "kms:GetPublicKey"
      ],
      "Resource": "arn:aws:kms:eu-north-1:102076848988:key/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Product": "AccessProof",
          "aws:ResourceTag/Purpose": "IndependentCertifier"
        }
      }
    },
    {
      "Sid": "CertifierKeyAliasOnly",
      "Effect": "Allow",
      "Action": [
        "kms:CreateAlias",
        "kms:DeleteAlias"
      ],
      "Resource": [
        "arn:aws:kms:eu-north-1:102076848988:alias/accessproof-independent-certifier-*",
        "arn:aws:kms:eu-north-1:102076848988:key/*"
      ]
    },
    {
      "Sid": "ListKmsAliasesRegion",
      "Effect": "Allow",
      "Action": "kms:ListAliases",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "NoProductionCommandsOrUnrelatedIam",
      "Effect": "Deny",
      "Action": [
        "ssm:StartSession",
        "iam:CreateUser",
        "iam:CreateAccessKey",
        "iam:CreateLoginProfile",
        "iam:AttachUserPolicy",
        "iam:PutUserPolicy",
        "iam:CreatePolicy",
        "iam:CreatePolicyVersion",
        "organizations:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "OnlyPublicAmazonLinuxAmiParameter",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameters",
        "ssm:GetParameter"
      ],
      "Resource": "arn:aws:ssm:eu-north-1::parameter/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
    },
    {
      "Sid": "RunApprovedDiagnosticsOnlyOnNewIsolatedCertifierHost",
      "Effect": "Allow",
      "Action": [
        "ssm:SendCommand"
      ],
      "Resource": [
        "arn:aws:ec2:eu-north-1:102076848988:instance/i-0af8a03948e7ba058",
        "arn:aws:ssm:eu-north-1::document/AWS-RunShellScript"
      ]
    },
    {
      "Sid": "ReadOnlyCertifierCommandOutcomesOnlyInStockholm",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations",
        "ssm:DescribeInstanceInformation"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    }
  ]
}
