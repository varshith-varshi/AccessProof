# AccessProof Alice/Bob Microsoft 365 test RAG — SAFE sample configuration.
# This is a source-checked EXAMPLE, not a running deployment.
# Copy values into a local private environment and supply app secrets securely.
# Neither this file nor the browser should contain employee passwords.

ACCESSPROOF_DEMO_SOURCE_PROVIDER=microsoft365
ACCESSPROOF_DEMO_ENTRA_TENANT_ID=6479e7ca-b256-4ebc-a408-871b9046547c
ACCESSPROOF_DEMO_ENTRA_DOMAIN=neuralmatrix093.onmicrosoft.com
ACCESSPROOF_DEMO_ENTRA_ALICE_EMAIL=alice@NeuralMatrix093.onmicrosoft.com
ACCESSPROOF_DEMO_ENTRA_BOB_EMAIL=bob@NeuralMatrix093.onmicrosoft.com
ACCESSPROOF_DEMO_ENTRA_REDIRECT_URI=http://localhost:8200/v1/auth/entra/callback
# ACCESSPROOF_DEMO_ENTRA_CLIENT_ID=<registered web application's client ID>
# ACCESSPROOF_DEMO_ENTRA_CLIENT_SECRET=<secure server-only value>

# Site-scoped ingestion uses the operator-owned AccessProof multitenant app.
# Only the dedicated synthetic SharePoint site has been granted read access.
ACCESSPROOF_MICROSOFT_TENANT_ID=6479e7ca-b256-4ebc-a408-871b9046547c
ACCESSPROOF_SHAREPOINT_SITE_ID=neuralmatrix093.sharepoint.com,9b00ec42-620a-4efc-acb3-f4d662c8ceb6,20231c9b-3196-4a5e-9ed0-0404090d5930
ACCESSPROOF_SHAREPOINT_LIST_ID=8200ffae-ba10-42c5-bfa9-8f7ac155c5c4
ACCESSPROOF_SHAREPOINT_DRIVE_ID=b!QuwAmwpi_E6ss_TWYsjOtpscIyCWMV5KntAEBAkNWTCu_wCCELrFQr-pj3rBVcXE
ACCESSPROOF_SHAREPOINT_ROOT_ITEM_ID=012JSJ74SOSX3HDJ2GXJBLWBEAD4WAJHZ2
# ACCESSPROOF_MICROSOFT_CLIENT_ID=b8424d54-5428-4d35-ae2c-639de7e512a9
# ACCESSPROOF_MICROSOFT_CLIENT_SECRET=<server-only operator app secret>

# Fail closed unless the independent SharePoint ingester publishes a valid signed snapshot.
ACCESSPROOF_DEMO_REQUIRE_ATTESTED_CONTENT=1
ACCESSPROOF_DEMO_TRUSTED_SNAPSHOT_PATH=/run/accessproof/trusted/sharepoint.snapshot.json
ACCESSPROOF_DEMO_ATTESTATION_TENANT=6479e7ca-b256-4ebc-a408-871b9046547c
# ACCESSPROOF_DEMO_ATTESTATION_KEY_ID=<registered public verification key ID>
# ACCESSPROOF_DEMO_ATTESTATION_PUBLIC_KEY_B64=<public key only>
# ACCESSPROOF_DEMO_SOURCE_ID=<AccessProof registered Microsoft source ID>
# ACCESSPROOF_DEMO_APPLICATION_ID=<AccessProof registered RAG application ID>

# Guard must verify the same Entra application (audience) and immutable 'oid'.
ACCESSPROOF_GUARD_IDENTITY_MODE=oidc
ACCESSPROOF_GUARD_JWT_ISSUER=https://login.microsoftonline.com/6479e7ca-b256-4ebc-a408-871b9046547c/v2.0
# ACCESSPROOF_GUARD_JWT_AUDIENCE=<Entra web app client ID>
ACCESSPROOF_GUARD_IDENTITY_TENANT_ID=6479e7ca-b256-4ebc-a408-871b9046547c
ACCESSPROOF_GUARD_IDENTITY_SUBJECT_CLAIM=oid
ACCESSPROOF_GUARD_FAIL_MODE=fail_closed
# Do not enable Protect without live per-employee source ACL evidence and signed certification.
