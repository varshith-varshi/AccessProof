# Trusted end-user JWT validation. These are verification values, never the
# Guard machine credential. Enroll stores that credential in ./state with 0600.
ACCESSPROOF_GUARD_JWT_ISSUER=https://issuer.example.com
ACCESSPROOF_GUARD_JWT_AUDIENCE=your-rag-service
ACCESSPROOF_GUARD_JWT_VERIFICATION_KEY=replace-with-your-verification-key
ACCESSPROOF_GUARD_MODE=protect
ACCESSPROOF_GUARD_FAIL_MODE=fail_closed
ACCESSPROOF_GUARD_SYNC_SECONDS=10
GUARD_PORT=8080
