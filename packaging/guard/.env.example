# Trusted end-user OIDC/JWKS validation. These are public verification values,
# never the Guard machine credential. Enroll stores that credential in ./state
# with 0600. Production must use `oidc`; `static` exists only for isolated
# development tests with a supplied symmetric verification key.
ACCESSPROOF_GUARD_IDENTITY_MODE=oidc
ACCESSPROOF_GUARD_JWT_ISSUER=https://issuer.example.com
ACCESSPROOF_GUARD_JWT_AUDIENCE=your-rag-service
ACCESSPROOF_GUARD_IDENTITY_SUBJECT_CLAIM=sub
# ACCESSPROOF_GUARD_IDENTITY_TENANT_ID=your-entra-tenant-id
# ACCESSPROOF_GUARD_IDENTITY_CACHE_SECONDS=300
ACCESSPROOF_GUARD_MODE=protect
ACCESSPROOF_GUARD_FAIL_MODE=fail_closed
ACCESSPROOF_GUARD_SYNC_SECONDS=10
GUARD_PORT=8080
