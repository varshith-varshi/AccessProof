# Customer-side AccessProof gateway. Do not commit deployment values.
ACCESSPROOF_GATEWAY_GUARD_URL=http://guard:8080
ACCESSPROOF_GATEWAY_MODEL_URL=http://your-model-service:8000/v1/chat/completions
ACCESSPROOF_GATEWAY_APPLICATION_ID=your-rag-application-id
ACCESSPROOF_GATEWAY_TENANT_ID=your-accessproof-tenant-id
ACCESSPROOF_GATEWAY_MODEL_NAME=
ACCESSPROOF_GATEWAY_MODEL_BEARER_TOKEN=
ACCESSPROOF_GATEWAY_MAX_REQUEST_BYTES=12000000
# Trusted operator-configured instruction; never supplied by employee requests.
ACCESSPROOF_GATEWAY_SYSTEM_INSTRUCTION=
# JSON map of key ID to base64url-encoded Ed25519 public key. Public keys only.
ACCESSPROOF_GATEWAY_ATTESTATION_PUBLIC_KEYS_JSON={"ingester-2026-01":"..."}
ACCESSPROOF_GATEWAY_MAX_RESPONSE_BYTES=1000000
